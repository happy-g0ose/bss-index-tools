-- ===== offline bssmvalues snapshot (bssmvalues_data.luau) =====
-- Generated data module: sticker means + full beequip variant prices (numeric
-- bounds as numbers, raw strings otherwise). A copy of it sits next to this
-- script; the copy that is actually loaded lives in Real's workspace folder,
-- which is the loadfile root. Loaded lazily: a getgenv() injection first, then
-- loadfile. Any failure here just falls through to the embedded tables above.
local offlineData, offlineAt, offlineRev = nil, -1e9, 0
local offStickerIdx, offBeequipIdx = nil, nil

-- mirrors normName below: lowercase, strip everything non-alphanumeric
local function offlineKey(s)
    return (string.lower(tostring(s)):gsub("[^%w]", ""))
end

local function buildOfflineIdx(tbl)
    local idx = {}
    for k in pairs(tbl) do
        if string.sub(k, 1, 1) ~= "_" then
            local kk = offlineKey(k)
            if idx[kk] == nil then idx[kk] = k end
        end
    end
    return idx
end

local function getOfflineData()
    if offlineData then return offlineData end
    if os.clock() - offlineAt < 10 then return nil end -- retry a missing module now and then
    offlineAt = os.clock()
    local mod
    local okg, injected = pcall(function() return getgenv().BSSM_VALUES_DATA end)
    if okg and type(injected) == "table" then
        mod = injected
    else
        local okf, fn = pcall(function() return loadfile("bssmvalues_data.luau") end)
        if okf and type(fn) == "function" then
            local okr, m = pcall(fn)
            if okr then mod = m end
        end
    end
    if type(mod) ~= "table" or type(mod.beequips) ~= "table" then return nil end
    offlineData = mod
    offlineRev = offlineRev + 1
    if type(mod.stickers) == "table" then offStickerIdx = buildOfflineIdx(mod.stickers) end
    offBeequipIdx = buildOfflineIdx(mod.beequips)
    local ns, nb = 0, 0
    for _ in pairs(mod.stickers or {}) do ns = ns + 1 end
    for _ in pairs(mod.beequips) do nb = nb + 1 end
    print(("[TradeValueOverlay] offline data: %d sticker means, %d beequips (gen %s)"):format(
        ns, nb, tostring(mod.generated)))
    return offlineData
end

-- name -> offline entry: exact match, known rename (nameMap), then normalized key
local function offlineResolve(tbl, idx, name)
    if type(tbl) ~= "table" then return nil end
    local hit = tbl[name]
    if hit ~= nil then return hit end
    local map = offlineData and offlineData.nameMap
    local mapped = type(map) == "table" and map[name] or nil
    if mapped and tbl[mapped] ~= nil then return tbl[mapped] end
    if idx then
        local k = idx[offlineKey(name)]
        if k ~= nil and tbl[k] ~= nil then return tbl[k] end
    end
    return nil
end

local function offlineStickerPrice(name)
    local data = getOfflineData()
    if not data then return nil end
    local p = offlineResolve(data.stickers, offStickerIdx, name)
    if type(p) == "number" then return p end
    return nil
end

local function offlineBqEntry(name)
    local data = getOfflineData()
    if not data then return nil end
    local e = offlineResolve(data.beequips, offBeequipIdx, name)
    if type(e) == "table" and type(e.stat_groups) == "table" then return e end
    return nil
end

local function offlineBqFlat(name)
    local e = offlineBqEntry(name)
    if e and type(e.flat) == "number" then return e.flat end
    return nil
end

-- image -> item (name + flat price); beequips are priced by roll, see beequipPriceFor
local imageInfo = {}
local priced, unpriced = 0, 0
for name, data in pairs(StickerTypes.Types) do
    if data.Image then
        local p = PRICES[name] or SITE_PRICES[name] or offlineStickerPrice(name)
        imageInfo[data.Image] = { name = name, price = p, isBeequip = false }
        if p then priced = priced + 1 else unpriced = unpriced + 1 end
    end
end
for name, data in pairs(BeequipTypes.Types) do
    if data.Icon then
        local p = PRICES[name] or SITE_PRICES[name] or offlineBqFlat(name)
        imageInfo[data.Icon] = { name = name, price = p, isBeequip = true }
        if p then priced = priced + 1 else unpriced = unpriced + 1 end
    end
end

